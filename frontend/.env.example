# Sin secretos. /api, /sanctum y /storage usan el proxy durante npm run dev.
# Abrir la SPA en http://127.0.0.1:5173; no mezclar localhost con 127.0.0.1.
# En producción publicar los tres prefijos en el mismo host o indicar VITE_API_URL.
VITE_API_URL=/api
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
